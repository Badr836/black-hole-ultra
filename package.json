{
  "name": "blackhole-ultra-downloader",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "node --import tsx tests/e2e.ts",
    "test:e2e:integration": "node --import tsx tests/e2e/integration.ts",
    "test:e2e:platforms": "node --import tsx tests/e2e/platforms.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:generate": "drizzle-kit generate",
    "test:ui": "node tests/ui-smoke.mjs",
    "test:browsers": "node tests/browsers.mjs",
    "upstream:check": "node scripts/upstream-check.mjs",
    "upstream:update": "node scripts/upstream-check.mjs --update",
    "issues:mine": "node scripts/issue-mining.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.64.1",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "version": "1.0.0",
  "description": "مدير تحميل محلي يعتمد yt-dlp + FFmpeg — بدون إعلانات ولا تتبع (SQLite، محلي أولاً)",
  "engines": {
    "node": ">=20.11"
  }
}
