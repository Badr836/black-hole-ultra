# BlackHole Ultra — كل الإعدادات اختيارية. التطبيق يعمل بدون أي ملف .env.

# مكان ملف قاعدة SQLite (الافتراضي: ./data/blackhole.db)
# BLACKHOLE_DB=/absolute/path/blackhole.db

# مجلد الحفظ الافتراضي (الافتراضي: ~/Downloads/BlackHole)
# DOWNLOAD_DIR=

# مسارات الأدوات التنفيذية (اتركها فارغة للبحث في bin/ ثم PATH)
# YTDLP_PATH=
# FFMPEG_PATH=
# FFPROBE_PATH=

# رمز وصول اختياري عند فتح التطبيق على الشبكة المحلية.
# إذا ضبطته، يجب إرسال الترويسة x-blackhole-token مع كل طلب /api
# BLACKHOLE_TOKEN=

# فحص صارم لمصدر الطلبات (Origin == Host) على POST/PUT/PATCH/DELETE.
# لا تشغّله داخل بيئات المعاينة المستضافة لأنها تعيد كتابة Host.
# BLACKHOLE_STRICT_ORIGIN=0
